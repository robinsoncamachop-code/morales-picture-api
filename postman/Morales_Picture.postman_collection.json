          "script": {
            "type": "text/javascript",
            "exec": [
              "// Comprueba automáticamente el código HTTP esperado.",
              "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Mensaje esperado', function () { pm.expect(pm.response.json().mensaje).to.eql(\"Error en la autenticación\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Registro duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/registro",
        "description": "Ejecute en el orden indicado. Verifique el código HTTP y la respuesta JSON."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Comprueba automáticamente el código HTTP esperado.",
              "pm.test('HTTP 409', function () { pm.response.to.have.status(409); });",
              "pm.test('Mensaje esperado', function () { pm.expect(pm.response.json().mensaje).to.eql(\"El usuario ya se encuentra registrado\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Campos faltantes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/registro",
        "description": "Ejecute en el orden indicado. Verifique el código HTTP y la respuesta JSON."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Comprueba automáticamente el código HTTP esperado.",
              "pm.test('HTTP 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    }
  ]
}
